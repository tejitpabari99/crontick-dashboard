{
  "name": "crontick-dashboard",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "crontick-dashboard": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "src/skill/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "echo \"build pipeline (gen:schemas, vite, tsup) added in Task 2\" && exit 0",
    "build:ui": "vite build ui",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build:ui && playwright test",
    "verify-package-install": "node scripts/verify-package-install.mjs",
    "verify-tarball": "node scripts/verify-tarball.mjs",
    "validate": "npm run lint && npm run typecheck && npm run build && npm test && npm run verify-tarball",
    "prepublishOnly": "npm run validate",
    "release": "npm run validate && npm publish"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "commander": "^12.1.0",
    "croner": "^10.0.1",
    "env-paths": "^4.0.0",
    "hono": "^4.13.13",
    "node-notifier": "^10.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
