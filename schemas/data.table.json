{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crontick table card data file",
  "description": "Data file (data.json) for a table card: the data key is bound to the table payload. Not expressible in JSON Schema, enforced by the validator: data must be an object unless error is a non-empty string; error \"\" is treated as null (default null); updatedAt must be an RFC 3339 timestamp with offset or Z. When error is set the payload is not validated. The generic data.json leaves the payload open; the validator applies the per-type payload schema chosen by the card type.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data": {
      "title": "crontick table card data",
      "description": "Not expressible in JSON Schema, enforced by the validator: every row must have exactly as many cells as columns; defaultSort.column must be within range; link values must be http, https, mailto or ms-outlook (max 2048 chars, no whitespace).",
      "type": "object",
      "properties": {
        "columns": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "sort": {
                    "type": "string",
                    "enum": [
                      "text",
                      "number",
                      "date"
                    ]
                  }
                },
                "required": [
                  "label"
                ],
                "additionalProperties": {}
              }
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cells": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        },
                        "link": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": {}
                    }
                  ]
                }
              },
              "link": {
                "type": "string"
              }
            },
            "required": [
              "cells"
            ],
            "additionalProperties": {}
          }
        },
        "defaultSort": {
          "type": "object",
          "properties": {
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "dir": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          "required": [
            "column",
            "dir"
          ],
          "additionalProperties": {}
        },
        "searchable": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": {}
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "updatedAt": {
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "enum": [
              null,
              ""
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    }
  ]
}
