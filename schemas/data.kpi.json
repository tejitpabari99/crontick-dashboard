{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crontick kpi card data file",
  "description": "Data file (data.json) for a kpi card: the data key is bound to the kpi payload. Not expressible in JSON Schema, enforced by the validator: data must be an object unless error is a non-empty string; error \"\" is treated as null (default null); updatedAt must be an RFC 3339 timestamp with offset or Z. When error is set the payload is not validated. The generic data.json leaves the payload open; the validator applies the per-type payload schema chosen by the card type.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data": {
      "title": "crontick kpi card data",
      "description": "Not expressible in JSON Schema, enforced by the validator: data must use either \"items\" or the flat single-metric form (value, label, unit, state, trend, link at the top level), not both; the flat form is normalized to items of length 1. This schema describes the canonical \"items\" form only; link values must be http, https, mailto or ms-outlook.",
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "ok",
                  "pending",
                  "fail",
                  "warn"
                ]
              },
              "trend": {
                "type": "object",
                "properties": {
                  "delta": {
                    "type": "number"
                  },
                  "dir": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down",
                      "flat"
                    ]
                  },
                  "good": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  }
                },
                "required": [
                  "delta"
                ],
                "additionalProperties": {}
              },
              "link": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": {}
          }
        }
      },
      "additionalProperties": {}
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "updatedAt": {
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "enum": [
              null,
              ""
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    }
  ]
}
